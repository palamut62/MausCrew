{
  "name": "mauscrew",
  "private": true,
  "version": "0.1.46",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/palamut62/MausCrew",
  "repository": {
    "type": "git",
    "url": "https://github.com/palamut62/MausCrew.git"
  },
  "author": {
    "name": "Umut Çelik",
    "url": "https://github.com/palamut62"
  },
  "license": "MIT",
  "desktopName": "com.mauscrew.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --experimental-strip-types server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "lint:strict": "eslint . --max-warnings 0",
    "test": "vitest run && pnpm test:updater",
    "test:updater": "node --test electron/*.node-test.mjs",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json && esbuild server/drivers/agui.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/drivers/agui.js && node scripts/copy-deepseek-assets.mjs && node scripts/prepare-host-cua.mjs",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:updater": "node scripts/bundle-updater.mjs",
    "package:prepare": "pnpm build && pnpm build:server && pnpm build:updater",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && electron-builder --mac --publish never",
    "package:win": "pnpm package:prepare && electron-builder --win --publish never",
    "package:linux": "pnpm package:prepare && electron-builder --linux --x64 --publish never",
    "package:linux:dir": "pnpm package:prepare && electron-builder --linux dir --x64 --publish never",
    "package": "pnpm package:mac"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.58",
    "@phosphor-icons/react": "^2.1.10",
    "@trycua/cua-driver": "0.20.0",
    "clsx": "^2.1.1",
    "posthog-js": "^1.415.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
